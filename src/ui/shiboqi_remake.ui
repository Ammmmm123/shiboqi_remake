        <string>
QWidget#page_pwm {
    background-color: #f8f9fa;
}

QGroupBox {
    background-color: white;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    margin-top: 28px;
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;;
    font-size: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #2c3e50;
    font-weight: bold;
    font-size: 16px;
    background-color: transparent;
}

QDial {
    background-color: transparent;
}

QSpinBox {
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: #ffffff;
    selection-background-color: #3498db;
    font-size: 14px;
    color: #495057;
    min-height: 20px;
}

QSpinBox:hover {
    border-color: #3498db;
    background-color: #f1f3f5;
}

QSpinBox:focus {
    border-color: #3498db;
    background-color: #ffffff;
}

QLabel {
    color: #6c757d;
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;;
    font-size: 14px;
}

QLabel#pwmFreqValue, QLabel#pwmDutyValue {
    color: #3498db;
    font-weight: bold;
    font-size: 18px;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;;
    font-weight: 600;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1f618d;
}

QPushButton:checked {
    background-color: #e74c3c;
}

QPushButton:checked:hover {
    background-color: #c0392b;
}

QComboBox {
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: #ffffff;
    selection-background-color: #3498db;
    font-size: 14px;
    color: #495057;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #3498db;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 2px solid #ced4da;
    border-bottom: 2px solid #ced4da;
    width: 8px;
    height: 8px;
    transform: rotate(-45deg);
    margin-right: 8px;
    margin-top: -2px;
}
